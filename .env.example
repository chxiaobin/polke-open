# Copy to .env and fill in. Only needed for the LLM detector tiers
# (hybrid/llm tiers — 280 of the 670 constructs); the rule and lexicon
# tiers run fully offline without any key.
OPENAI_API_KEY=

# Chat model used by the reading classifiers (optional).
POLKE_LLM_MODEL=gpt-4o-mini

# spaCy pipeline (optional). Install with: python -m spacy download <name>
POLKE_SPACY_MODEL=en_core_web_sm
