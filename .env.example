# Copy to .env and fill in. Only needed for the LLM detector tiers
# (hybrid/llm tiers — 280 of the 670 constructs); the rule and lexicon
# tiers run fully offline without any key.
OPENAI_API_KEY=

# Chat model used by the reading classifiers (optional).
POLKE_LLM_MODEL=gpt-4o-mini

# Self-hosted OpenAI-compatible server (vLLM etc.) instead of the OpenAI
# API (optional). Set POLKE_LLM_NO_THINK=1 if the served models have
# reasoning/thinking mode enabled — otherwise they spend the whole
# completion budget thinking and return empty answers.
#OPENAI_BASE_URL=https://your-cluster/v1
#POLKE_LLM_NO_THINK=1

# spaCy pipeline (optional). Install with: python -m spacy download <name>
POLKE_SPACY_MODEL=en_core_web_sm

# Recall-probe model for `polke probe` (optional; default: POLKE_LLM_MODEL).
# Prefer a model from a DIFFERENT provider than the annotator so probe errors
# don't correlate with the LLM tiers. claude-* models run on the Anthropic
# API and need `pip install anthropic` plus ANTHROPIC_API_KEY below.
POLKE_PROBE_MODEL=
ANTHROPIC_API_KEY=

# Level verifier (polke level / GET /verify): sentences analysed in parallel
# when the LLM tiers are on, and per-request caps (optional).
#POLKE_SENTENCE_CONCURRENCY=3
#POLKE_MAX_SENTENCES=500
#POLKE_MAX_CHARS=100000
